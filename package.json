{
  "name": "ai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/*.test.ts",
    "test:fast": "AI_LOCAL_BASE_URL=http://127.0.0.1:1 AI_LOCAL_EMBEDDING_DIM=32 node --experimental-strip-types --test --test-concurrency=1 tests/*.test.ts",
    "test:integration": "node --experimental-strip-types --test --test-concurrency=1 tests/*.integration.test.ts",
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --experimental-strip-types apps/api/src/main.ts",
    "dev:web": "node --experimental-strip-types apps/web/src/server.ts",
    "dev:worker": "node --experimental-strip-types apps/worker/src/main.ts",
    "api": "node --experimental-strip-types apps/api/src/main.ts",
    "mcp": "node --experimental-strip-types mcp/server/src/main.ts",
    "web": "node --experimental-strip-types cli/ai/src/main.ts web",
    "cli": "node --experimental-strip-types cli/ai/src/main.ts",
    "worker": "node --experimental-strip-types apps/worker/src/main.ts",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format",
    "format:fix": "biome format --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16"
  },
  "dependencies": {
    "acorn": "^8.17.0",
    "acorn-typescript": "^1.4.13"
  }
}
