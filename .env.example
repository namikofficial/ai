# AI Workbench local environment.
#
# Local-first by default. AI_CLOUD_ENABLED must be set to `true`
# explicitly to unlock cloud providers; the default model catalog
# has every profile marked local-only.

AI_DATABASE_PATH=./runtime/ai.db
AI_RUNTIME_DIR=./runtime
AI_API_PORT=4417
AI_WEB_PORT=4317
AI_API_URL=http://127.0.0.1:4417

# Cloud: must be explicitly enabled. Off by default.
AI_CLOUD_ENABLED=false

# Vector store (optional). The workbench falls back to SQLite FTS
# when Qdrant is unreachable.
AI_QDRANT_ENABLED=true
AI_QDRANT_URL=http://127.0.0.1:6333
AI_QDRANT_COLLECTION=ai_chunks

# Local llama-swap / llama.cpp OpenAI-compatible endpoint.
# The default model catalog seeds `provider_llamacpp_local` against
# this URL and routes the most-used local profiles to it.
AI_LOCAL_BASE_URL=http://127.0.0.1:8080/v1

# Per-model-call timeout in milliseconds. When a local model takes
# longer than this, the runtime aborts the request and falls back
# to the configured fallback profile. Default 60000 (60s).
AI_MODEL_TIMEOUT_MS=60000

# Per-role model names. Match the models actually served by your
# llama-swap; defaults are tuned for the workstation's small/local set.
AI_LOCAL_MODEL_FAST=qwen3-4b-local
AI_LOCAL_MODEL_DEEP=qwen3-4b-local
AI_LOCAL_MODEL_CODER=qwen3-4b-local
AI_LOCAL_MODEL_REASONER=granite-agent
AI_LOCAL_MODEL_ROUTER=qwen3-4b-local
AI_LOCAL_MODEL_TINY=qwen3-4b-local
AI_LOCAL_MODEL_FAST2=qwen3-4b-local
AI_LOCAL_MODEL_TINY2=qwen3-4b-local

# Embeddings run on a separate llama.cpp server, not the chat endpoint.
AI_EMBEDDING_BASE_URL=http://127.0.0.1:8081/v1
AI_EMBEDDING_MODEL=nomic-text-embed
AI_LOCAL_EMBEDDING_MODEL=nomic-text-embed
AI_LOCAL_EMBEDDING_DIM=768
AI_EMBEDDING_PROVIDER=llama_cpp
AI_EMBEDDING_BATCH_SIZE=32
