AI_DATABASE_PATH=./runtime/ai.db
AI_RUNTIME_DIR=./runtime
AI_API_PORT=4242
AI_WEB_PORT=3000
AI_API_URL=http://127.0.0.1:4242
AI_CLOUD_ENABLED=false
AI_QDRANT_ENABLED=true
AI_QDRANT_URL=http://127.0.0.1:6333
AI_QDRANT_COLLECTION=ai_chunks

# Local llama.cpp / llama-swap OpenAI-compatible endpoint.
# The default model catalog now seeds `provider_llamacpp_local`
# against this URL and routes the most-used local profiles to it.
AI_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
AI_LOCAL_MODEL_FAST=qwen2.5-coder:7b
AI_LOCAL_MODEL_DEEP=qwen2.5-coder:14b
AI_LOCAL_MODEL_CODER=qwen2.5-coder:14b
AI_LOCAL_EMBEDDING_MODEL=nomic-embed-text
