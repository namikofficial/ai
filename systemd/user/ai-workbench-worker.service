[Unit]
Description=AI Workbench background worker
Documentation=file:%h/Documents/code/ai/docs/RUNTIME_SUPERVISION.md
Requires=ai-workbench.service
After=ai-workbench.service
PartOf=ai-workbench.target

[Service]
Type=simple
WorkingDirectory=%h/Documents/code/ai
EnvironmentFile=-%h/.config/ai-workbench/runtime.env
Environment=PATH=%h/.local/share/pnpm:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env pnpm worker
Restart=on-failure
RestartSec=2
TimeoutStartSec=20
TimeoutStopSec=20
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077

[Install]
WantedBy=ai-workbench.target
