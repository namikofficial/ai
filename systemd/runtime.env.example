# Copy to ~/.config/ai-workbench/runtime.env and customize in one place.
# Paths default to the repository's runtime directory when omitted.
AI_API_PORT=4417
AI_WEB_PORT=4317
AI_API_URL=http://127.0.0.1:4417
AI_WORKBENCH_API_URL=http://127.0.0.1:4417
AI_WORKBENCH_URL=http://127.0.0.1:4317

# Local capabilities are optional. Core readiness does not depend on them.
AI_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
AI_EMBEDDING_BASE_URL=http://127.0.0.1:8081/v1
AI_QDRANT_ENABLED=false
AI_QDRANT_URL=http://127.0.0.1:6333
AI_QDRANT_COLLECTION=ai_chunks
AI_CLOUD_ENABLED=false
AI_WORKBENCH_NOTIFICATIONS_ENABLED=true

# Optional approved workflow-secret provider. The referenced file must be owned
# by the current user and mode 0600. It contains KEY=value entries; manifests
# still have to approve each key through secretRefs/environmentRefs.
# AI_WORKBENCH_SECRET_FILE=%h/.config/ai-workbench/workflow-secrets.env
